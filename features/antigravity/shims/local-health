#!/usr/bin/env bash
# local-health — check health of local inference & chat services
# Usage: local-health [heretic|chat|ask_local|comfyui|all] (default all)
set -u

target="${1:-all}"

if [[ $# -gt 1 ]]; then
    echo "usage: local-health [heretic|chat|ask_local|comfyui|all]" >&2
    exit 2
fi

case "$target" in
    heretic|chat|ask_local|comfyui|all) ;;
    *)
        echo "unknown service: $target" >&2
        echo "usage: local-health [heretic|chat|ask_local|comfyui|all]" >&2
        exit 2
        ;;
esac

check_service() {
    local name="$1"
    local url="$2"
    local code
    code="$(curl -s -m 5 -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || true)"
    code="${code:-000}"
    if [[ "$code" == "000"* ]]; then
        code="000"
    fi
    local state="down"
    if [[ "$code" =~ ^[23][0-9]{2}$ ]]; then
        state="up"
    fi
    printf "%s %s %s\n" "$name" "$state" "$code"
}

case "$target" in
    heretic)
        check_service heretic "http://127.0.0.1:8090/health"
        ;;
    chat)
        check_service chat "http://127.0.0.1:8091/"
        ;;
    ask_local)
        check_service ask_local "http://127.0.0.1:11434/api/tags"
        ;;
    comfyui)
        check_service comfyui "http://127.0.0.1:8188/system_stats"
        ;;
    all)
        check_service heretic "http://127.0.0.1:8090/health"
        check_service chat "http://127.0.0.1:8091/"
        check_service ask_local "http://127.0.0.1:11434/api/tags"
        check_service comfyui "http://127.0.0.1:8188/system_stats"
        ;;
esac
