#!/usr/bin/env bash
# One shim for every command agy reaches for out of habit (python3, pytest, find, sed, jq...):
# outside the sandbox, hand off to sandbox-run with the bare command name so sandbox-run's
# internal PATH (.venv/bin first, then system) resolves it inside bwrap. Inside the sandbox,
# find and exec the real binary skipping this shim directory without recursing.
set -euo pipefail
name="$(basename "$0")"

if [[ ! -d "/run/sandbox-run-inside" ]]; then
    exec sandbox-run "$name" "$@"
fi

here="$(cd "$(dirname "$0")" && pwd -P)"
real=""
IFS=: read -ra dirs <<< "${PATH:-}"
for d in "${dirs[@]}"; do
    [[ -z "$d" || "$(cd "$d" 2>/dev/null && pwd -P)" == "$here" ]] && continue
    if [[ -x "$d/$name" && ! -d "$d/$name" ]]; then real="$d/$name"; break; fi
done
[[ -n "$real" ]] || { echo "shim: no real '$name' on PATH" >&2; exit 127; }
real="$(readlink -f "$real")"
exec "$real" "$@"
