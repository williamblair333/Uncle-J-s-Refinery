{
  "env": {
    "CHROMA_API_IMPL": "chromadb.api.segment.SegmentAPI",
    "MSYS": "winsymlinks:nativestrict"
  },
  "permissions": {
    "allow": [
      "mcp__jcodemunch__plan_turn",
      "mcp__jcodemunch__resolve_repo",
      "mcp__jcodemunch__suggest_queries",
      "mcp__jcodemunch__search_symbols",
      "mcp__jcodemunch__search_text",
      "mcp__jcodemunch__search_columns",
      "mcp__jcodemunch__get_file_outline",
      "mcp__jcodemunch__get_symbol_source",
      "mcp__jcodemunch__get_context_bundle",
      "mcp__jcodemunch__get_file_content",
      "mcp__jcodemunch__get_repo_outline",
      "mcp__jcodemunch__get_file_tree",
      "mcp__jcodemunch__find_importers",
      "mcp__jcodemunch__find_references",
      "mcp__jcodemunch__check_references",
      "mcp__jcodemunch__get_dependency_graph",
      "mcp__jcodemunch__get_blast_radius",
      "mcp__jcodemunch__get_changed_symbols",
      "mcp__jcodemunch__find_dead_code",
      "mcp__jcodemunch__get_class_hierarchy",
      "mcp__jcodemunch__get_session_context",
      "mcp__jcodemunch__index_file",
      "mcp__jcodemunch__list_repos",
      "mcp__jcodemunch__register_edit",
      "Bash(crontab -l)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh checkpoint",
            "statusMessage": "Checkpointing..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh commit-guard",
            "statusMessage": "Checking docs are staged..."
          },
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh grep-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh edit-surface-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh mcp-log",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh session-notify",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh skill-suggest",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh skill-link unlink",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh memweave-sync",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh unpushed-warn",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh probe",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh skill-link link"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh review-check",
            "timeout": 30,
            "statusMessage": "Checking _review/..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/util/apps/Git/bin/bash.exe C:/opt/proj/Uncle-J-s-Refinery/scripts/win/hook.sh autofix",
            "timeout": 60,
            "statusMessage": "Health check + auto-fix..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ralph-wiggum@claude-code-plugins": true,
    "understand-anything@understand-anything": true
  }
}
